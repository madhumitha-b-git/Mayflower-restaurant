# Supabase Configuration (Public - Safe for browser)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SITE_URL=http://localhost:5173

# Server-Side Only Secrets (Never expose with VITE_ prefix or commit to client bundle)
# Supabase Service Role Key for backend administration
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gmail API — OAuth 2.0 Credentials
# From Google Cloud Console -> APIs & Services -> Credentials
Gmail_api_client_id=your-client-id.apps.googleusercontent.com
Gmail_api_client_secret=GOCSPX-your-client-secret
# Obtained via node scripts/get-gmail-token.mjs
GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token
# Sender Email Address or display name
GMAIL_USER=reservations@mayflower.com
EMAIL_FROM=The Mayflower <me>

# Application Configuration
VITE_APP_ENV=development
